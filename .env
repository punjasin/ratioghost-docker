# Ratio Ghost settings — edit and `docker compose up -d` to apply.
RG_BIND=0.0.0.0
RG_LISTEN_PORT=3773
RG_ONLY_LOCAL=0

# Actual-upload mode: report the real upload (no inflation/boost), download as 0.
RG_NO_DOWNLOAD=1
RG_NO_INFLATE=1

